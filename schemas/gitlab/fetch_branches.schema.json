{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tetriz-ai/tetriz-connectors/schemas/gitlab/fetch_branches.schema.json",
  "title": "gitlab fetch_branches",
  "description": "One branch: the GitLab REST branch object (GET /projects/:id/repository/branches) passed through unchanged. Keys are snake_case. The metadata repeats the fields consumers need as strings.",
  "type": "object",
  "required": ["name", "commit"],
  "additionalProperties": true,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "commit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "description": "Head commit SHA."},
        "committed_date": {"type": "string", "format": "date-time"}
      }
    },
    "default": {"type": "boolean"},
    "protected": {"type": "boolean"},
    "merged": {"type": "boolean"},
    "developers_can_push": {"type": "boolean"},
    "developers_can_merge": {"type": "boolean"},
    "can_push": {"type": "boolean"},
    "web_url": {"type": "string"}
  }
}
