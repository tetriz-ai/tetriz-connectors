{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tetriz-ai/tetriz-connectors/schemas/common/jira.json",
  "title": "Jira shared shapes",
  "description": "Shapes the Jira REST API v3 and Agile API 1.0 bodies share. Not a record schema.",
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})$",
      "description": "Jira timestamp, such as 2026-01-16T15:03:31.606+0200. The offset has no colon, so it is not RFC 3339."
    },
    "nullableTime": {
      "anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]
    },
    "user": {
      "type": "object",
      "description": "A Jira user. emailAddress is absent when the user hides it.",
      "additionalProperties": true,
      "properties": {
        "self": {"type": "string"},
        "accountId": {"type": "string"},
        "accountType": {"type": "string"},
        "displayName": {"type": "string"},
        "emailAddress": {"type": "string"},
        "active": {"type": "boolean"},
        "timeZone": {"type": "string"}
      }
    },
    "nullableUser": {
      "anyOf": [{"$ref": "#/$defs/user"}, {"type": "null"}]
    },
    "adf": {
      "description": "Atlassian Document Format: a JSON tree with type doc at the root. Null when the field is empty.",
      "anyOf": [
        {"type": "object", "required": ["type"], "additionalProperties": true, "properties": {"type": {"type": "string"}, "version": {"type": "integer"}, "content": {"type": "array"}}},
        {"type": "null"}
      ]
    }
  }
}
