{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tetriz-ai/tetriz-connectors/schemas/jira/fetch_issues.schema.json",
  "title": "jira fetch_issues",
  "description": "One issue, as the Jira REST API v3 search returns it with fields=*all and expand=changelog,renderedFields, byte for byte. The created, snapshot and resolved records of an issue carry the same payload; metadata event_type tells them apart. Custom fields appear as customfield_<n> with site-specific shapes.",
  "type": "object",
  "required": ["id", "key", "fields"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]+$", "description": "Numeric issue id, as a string. Stable across moves; the record's ExternalID is <id>#<event>."},
    "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$", "description": "Issue key, such as ENG-42. It changes when the issue moves to another project."},
    "self": {"type": "string"},
    "expand": {"type": "string"},
    "fields": {
      "type": "object",
      "required": ["created", "updated"],
      "additionalProperties": true,
      "properties": {
        "created": {"$ref": "../common/jira.json#/$defs/time"},
        "updated": {"$ref": "../common/jira.json#/$defs/time"},
        "resolutiondate": {"$ref": "../common/jira.json#/$defs/nullableTime"},
        "summary": {"type": "string"},
        "description": {"$ref": "../common/jira.json#/$defs/adf"},
        "status": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": {"type": "string"},
            "statusCategory": {
              "type": "object",
              "additionalProperties": true,
              "properties": {"key": {"type": "string", "description": "new, indeterminate or done."}}
            }
          }
        },
        "project": {
          "type": "object",
          "additionalProperties": true,
          "properties": {"id": {"type": "string"}, "key": {"type": "string"}, "name": {"type": "string"}}
        },
        "issuetype": {"type": "object", "additionalProperties": true, "properties": {"name": {"type": "string"}, "subtask": {"type": "boolean"}}},
        "priority": {"anyOf": [{"type": "object", "additionalProperties": true, "properties": {"name": {"type": "string"}}}, {"type": "null"}]},
        "resolution": {"anyOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
        "assignee": {"$ref": "../common/jira.json#/$defs/nullableUser"},
        "reporter": {"$ref": "../common/jira.json#/$defs/nullableUser"},
        "creator": {"$ref": "../common/jira.json#/$defs/nullableUser"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "duedate": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "parent": {"type": "object", "additionalProperties": true, "properties": {"id": {"type": "string"}, "key": {"type": "string"}}}
      }
    },
    "changelog": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "startAt": {"type": "integer"},
        "maxResults": {"type": "integer"},
        "total": {"type": "integer"},
        "histories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "author": {"$ref": "../common/jira.json#/$defs/user"},
              "created": {"$ref": "../common/jira.json#/$defs/time"},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "field": {"type": "string"},
                    "fieldtype": {"type": "string"},
                    "from": {"type": ["string", "null"]},
                    "fromString": {"type": ["string", "null"]},
                    "to": {"type": ["string", "null"]},
                    "toString": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "renderedFields": {"type": "object", "additionalProperties": true, "description": "The fields rendered to HTML strings."}
  }
}
