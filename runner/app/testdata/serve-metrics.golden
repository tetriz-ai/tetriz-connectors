Desc{fqName: "tetriz_anthropic_coverage_unbounded_total", help: "Claude analytics runs that claimed coverage with no finality bound, the vendor's watermark being too stale to apply.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_pages_read_total", help: "Vendor pages read by the Claude analytics operations.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_periods_covered_total", help: "Units (a day, a chunk, a snapshot) the Claude analytics operations advanced their position past.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_position_far_behind_total", help: "Claude analytics runs whose stored position is further behind the clock than a converging backfill would be.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_position_unreadable_total", help: "Claude analytics runs that could not read their stored position and restarted from the lookback.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_records_emitted_total", help: "Claude analytics records accepted by the sink.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_rows_unreadable_total", help: "Vendor rows the Claude analytics operations could not key, each of which fails its run.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_run_covered_total", help: "Claude analytics runs that reached the furthest point they could claim (the clock, or the vendor's currency when nearer).", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_anthropic_run_yielded_total", help: "Claude analytics runs that stopped short of covering their window and reported success, by why they stopped.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id,reason}}
Desc{fqName: "tetriz_anthropic_vendor_bad_request_total", help: "Vendor 400 responses to the Claude analytics operations, by what the 400 means.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id,kind}}
Desc{fqName: "tetriz_bitbucket_circuit_breaker_opened_total", help: "Count of per-(group, org) circuit-breaker trips. Each trip pauses Bitbucket traffic for that org until the cooldown expires.", unit: "", constLabels: {}, variableLabels: {group,org_id}}
Desc{fqName: "tetriz_bitbucket_ratelimit_429_total", help: "Count of HTTP 429 responses from Bitbucket REST per (group, org). Spikes correlate with the circuit breaker tripping.", unit: "", constLabels: {}, variableLabels: {group,org_id}}
Desc{fqName: "tetriz_bitbucket_ratelimit_acquire_total", help: "Local rate-limit decisions per (group, org, operation, outcome). granted consumed a token; limited was rejected by the local bucket; circuit_open was refused upstream of the bucket during a 429 storm (no token spent); error means the limiter itself failed. Sum over all four outcomes is the operation's attempted demand.", unit: "", constLabels: {}, variableLabels: {group,org_id,operation,outcome}}
Desc{fqName: "tetriz_bitbucket_ratelimit_budget_remaining", help: "Bitbucket X-RateLimit-Remaining for the most recent response, per (group, org). Negative or zero values mean the org is at the bucket floor and the next call will 429.", unit: "", constLabels: {}, variableLabels: {group,org_id}}
Desc{fqName: "tetriz_codex_days_covered_total", help: "Codex usage calendar days read to completion.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_days_without_records_total", help: "Codex usage days that read more than one page and stored no records, which means a page was fetched and dropped.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_pages_read_total", help: "Codex usage page requests issued to the vendor.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_position_unreadable_total", help: "Codex usage runs that could not read their stored position and restarted from the lookback.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_records_emitted_total", help: "Codex usage records accepted by the sink.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_rows_unreadable_total", help: "Codex usage rows that could not be keyed, which means the response shape has drifted.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_run_covered_total", help: "Codex usage runs that reached the newest day available to them.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id}}
Desc{fqName: "tetriz_codex_run_yielded_total", help: "Codex usage runs that stopped short of covering their window, by why they stopped.", unit: "", constLabels: {}, variableLabels: {org_id,operation_id,reason}}
Desc{fqName: "tetriz_connector_anthropic_rate_limit_shared_bucket_total", help: "Count of Anthropic rate-limit acquisitions that fell back to the shared bucket (missing org_id on context).", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_connector_codex_rate_limit_shared_bucket_total", help: "Count of Codex rate-limit acquisitions that fell back to the shared bucket (missing org_id on context).", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_connector_cursor_oldest_entry_age_seconds", help: "Age of the oldest per-entry watermark an operation's cursor holds, refreshed on each cursor save. Distinguishes an entry idle because there is no new data from one pinned at a synthetic first-sync floor — a pin parks this near the connector's lookback and never moves.", unit: "", constLabels: {}, variableLabels: {connector_id,operation_id,org_id}}
Desc{fqName: "tetriz_connector_cursor_regressions_total", help: "Count of per-entry cursor watermarks that moved backward across a run. A cursor is monotonic by contract, so any increment is a defect: the affected entry re-scans an already-consumed window on every subsequent tick, spending vendor budget forever, and its sync state reads as though the entry never synced.", unit: "", constLabels: {}, variableLabels: {connector_id,operation_id,org_id}}
Desc{fqName: "tetriz_connector_disconnects_total", help: "Count of connectors removed via a user-initiated DisconnectIntegration (one per successful config soft-delete). A removal stops all sync runs, so no other connector series signals it — this is the only positive edge it emits.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id}}
Desc{fqName: "tetriz_connector_fetch_cache_oversized_skipped_total", help: "Count of fetch-cache entries skipped because the serialized value exceeded the per-row size cap. Nonzero rate flags a pathological cache value (a giant-file PR); the entry is re-fetched each cycle, so correctness holds but memoization is lost for it.", unit: "", constLabels: {}, variableLabels: {connector_id,cache_type,org_id}}
Desc{fqName: "tetriz_connector_fetch_cache_read_total", help: "Count of fetch-cache key lookups labelled hit/miss. Once warm the two _last_fetched cache_types run at a near-100% hit share; a sustained cold-miss share means the table is not being warmed for that cache_type.", unit: "", constLabels: {}, variableLabels: {connector_id,cache_type,result,org_id}}
Desc{fqName: "tetriz_connector_fetch_cache_rows", help: "Rows currently held in connector_fetch_cache per (org, connector, cache_type), refreshed on each cache-write cycle. Sustained growth past the expected working-set size is the signal to run a host's eviction job.", unit: "", constLabels: {}, variableLabels: {connector_id,cache_type,org_id}}
Desc{fqName: "tetriz_connector_fetch_cache_rows_written_total", help: "Count of fetch-cache rows the cache write actually persisted (DAO RowsAffected — the value-guarded upsert skips unchanged rows). Reflects genuine churn; a warm cache trends toward zero writes even as it keeps offering the same keys.", unit: "", constLabels: {}, variableLabels: {connector_id,cache_type,org_id}}
Desc{fqName: "tetriz_connector_harness_file_content_artifacts_total", help: "fetch_file_content artifacts by connector and terminal outcome (emitted|tombstone|deferred_*). A rising deferred_budget share on one connector is the per-vendor budget-pressure signal.", unit: "", constLabels: {}, variableLabels: {connector,outcome}}
Desc{fqName: "tetriz_connector_harness_file_content_files_fetched_total", help: "Files fetched and staged by fetch_file_content, by connector — one per file after a successful staging write.", unit: "", constLabels: {}, variableLabels: {connector}}
Desc{fqName: "tetriz_connector_health_state_transitions_total", help: "Total connector health-state transitions by connector and target state.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,to}}
Desc{fqName: "tetriz_connector_health_write_failures_total", help: "Count of best-effort connector health-state writes that failed, by direction. revoke = the connector was never paused after a dead credential; reset = it stayed gated after the customer reconnected. Either way that (org, connector) makes no progress until someone intervenes.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,direction}}
Desc{fqName: "tetriz_connector_last_successful_sync_timestamp_seconds", help: "Unix timestamp (seconds) of the most recent successful sync for an (org, connector, operation) triple.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,operation_id}}
Desc{fqName: "tetriz_connector_linear_op_duration_seconds", help: "Wall-clock duration of a Linear connector operation run, by operation, org, and status.", unit: "", constLabels: {}, variableLabels: {operation_id,org_id,status}}
Desc{fqName: "tetriz_connector_linear_rate_limit_shared_bucket_total", help: "Count of Linear rate-limit acquisitions that fell back to the shared bucket (missing org_id on context).", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_connector_linear_records_fetched_total", help: "Count of Linear raw records emitted to the sink, by operation and org.", unit: "", constLabels: {}, variableLabels: {operation_id,org_id}}
Desc{fqName: "tetriz_connector_local_rate_limit_giveup_total", help: "Count of times local-limit pacing gave up (returned the rejection unchanged) instead of waiting, by reason (budget_cap|no_deadline|deadline_too_near). Sustained non-zero for an (org, connector) means the org is near its real vendor cap and the per-run budget can no longer absorb it.", unit: "", constLabels: {}, variableLabels: {connector_id,operation_id,org_id,reason}}
Desc{fqName: "tetriz_connector_local_rate_limit_wait_seconds", help: "Seconds an operation slept waiting out our OWN local rate limiter (not a vendor 429). Sustained growth for an (org, connector) means it is nearing its real vendor cap and the local budget should rise.", unit: "", constLabels: {}, variableLabels: {connector_id,operation_id,org_id}}
Desc{fqName: "tetriz_connector_repo_tree_fetch_errors_total", help: "Total errors encountered while fetching a repository tree, classified by connector and reason.", unit: "", constLabels: {}, variableLabels: {connector,reason}}
Desc{fqName: "tetriz_connector_repo_tree_walker_subtree_fetches_total", help: "Total non-recursive per-subtree API fetches performed during BFS fallback tree walk.", unit: "", constLabels: {}, variableLabels: {connector}}
Desc{fqName: "tetriz_connector_schedule_suppressed_total", help: "Connector schedule entries withheld by an organisation-scoped gate.", unit: "", constLabels: {}, variableLabels: {connector_id,org_id}}
Desc{fqName: "tetriz_connector_sink_emit_total", help: "Total records emitted through the connector sink.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,operation_id,status}}
Desc{fqName: "tetriz_connector_sync_run_duration_seconds", help: "Duration of connector sync runs in seconds.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,operation_id}}
Desc{fqName: "tetriz_connector_sync_run_error_total", help: "Total connector sync run errors by connector and error kind.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,operation_id,error_kind}}
Desc{fqName: "tetriz_connector_sync_run_total", help: "Total connector sync runs by connector, operation, and outcome.", unit: "", constLabels: {}, variableLabels: {org_id,connector_id,operation_id,status}}
Desc{fqName: "tetriz_connector_vcs_repositories_tree_fetched_total", help: "Total repository trees successfully fetched and uploaded to S3.", unit: "", constLabels: {}, variableLabels: {connector,truncated}}
Desc{fqName: "tetriz_connector_vendor_permission_denied_total", help: "Count of vendor responses indicating a per-org permission gap (403/406). Sustained non-zero rate for any (org, connector) means the installation is missing scope and the connector cannot make progress — an admin must re-consent / re-install the vendor app.", unit: "", constLabels: {}, variableLabels: {connector_id,operation_id,status_code,org_id}}
Desc{fqName: "tetriz_cursor_usage_events_skipped_total", help: "Billed Cursor usage events skipped because no routing identity could be constructed.", unit: "", constLabels: {}, variableLabels: {org_id}}
Desc{fqName: "tetriz_cursor_usage_run_yielded_total", help: "Cursor usage runs that stopped short of covering their window and reported success, by why they stopped.", unit: "", constLabels: {}, variableLabels: {org_id,reason}}
Desc{fqName: "tetriz_cursor_usage_window_completed_total", help: "Cursor usage runs that covered their whole window before returning.", unit: "", constLabels: {}, variableLabels: {org_id}}
Desc{fqName: "tetriz_dao_function_run_duration_seconds", help: "time taken by each dao functions", unit: "", constLabels: {}, variableLabels: {service_name,pkg_path,struct_name,func_name}}
Desc{fqName: "tetriz_gateway_oauth_refresh_duration_seconds", help: "OAuth refresh duration in seconds for successful refreshes, by vendor.", unit: "", constLabels: {}, variableLabels: {vendor}}
Desc{fqName: "tetriz_gateway_oauth_refresh_total", help: "Total OAuth token-refresh attempts by vendor and outcome (success / invalid_grant / rate_limit / transport / unknown).", unit: "", constLabels: {}, variableLabels: {vendor,outcome}}
Desc{fqName: "tetriz_gateway_request_duration_seconds", help: "VendorGateway HTTP request duration in seconds, by vendor.", unit: "", constLabels: {}, variableLabels: {vendor}}
Desc{fqName: "tetriz_gateway_requests_total", help: "Total VendorGateway HTTP requests by vendor, HTTP status, and outcome.", unit: "", constLabels: {}, variableLabels: {vendor,status,http_status}}
Desc{fqName: "tetriz_gitlab_circuit_breaker_opened_total", help: "Count of per-(group, org) circuit-breaker trips. Each trip pauses GitLab traffic for that org until the cooldown expires.", unit: "", constLabels: {}, variableLabels: {group,org_id}}
Desc{fqName: "tetriz_kiro_empty_days_total", help: "Count of days walked that held no Kiro reports. Correct before reporting is enabled and on any day the vendor skipped; read alongside reports_copied_total, where a rising empty rate against a flat copied rate is a grant that has gone away.", unit: "", constLabels: {}, variableLabels: {org_id}}
Desc{fqName: "tetriz_kiro_reports_abandoned_total", help: "Count of Kiro report files settled as permanently unreadable and skipped thereafter. Expected value is zero: collection continues past these, so no run fails and nothing else records that a report will never arrive.", unit: "", constLabels: {}, variableLabels: {org_id}}
Desc{fqName: "tetriz_kiro_reports_copied_total", help: "Count of Kiro report files copied from a customer's bucket into the configured blob store, by organisation and client type. A flat rate for an organisation that was collecting is the signal that collection stopped without any run failing.", unit: "", constLabels: {}, variableLabels: {org_id,client_type}}
Desc{fqName: "tetriz_kiro_reports_unplaceable_total", help: "Count of objects under a Kiro day prefix whose key does not match the documented report layout, by organisation. Neither collected nor settled: the day completes without them. A non-zero rate is either a vendor file this connector does not expect, or the layout assumption being wrong.", unit: "", constLabels: {}, variableLabels: {org_id}}
Desc{fqName: "tetriz_rate_limiter_allow_bulk_request_total", help: "Number of allow bulk request calls", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_allow_request_total", help: "Number of allow request calls", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_allow_total", help: "Number of allow calls", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_bulk_allow_time_duration_milliseconds", help: "total time taken to add bulk requests", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_bulk_err_total", help: "Total errors while checking bulk allow/remove request", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_bulk_remove_time_duration_milliseconds", help: "total time taken to remove bulk requests", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_decision_time_duration_milliseconds", help: "total time taken to decide if request is to be allowed or not", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_err_total", help: "Total errors while checking allow request", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_rate_limiter_remove_bulk_request_total", help: "Number of remove bulk request calls", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_redis_add_with_priority_time_milli_seconds", help: "total time taken to find if window is breached and add new member in set", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_redis_is_window_breached_time_milli_seconds", help: "total time taken to find if window is breached and add new member in set", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_redis_key_expire_time_milli_seconds", help: "total time taken to set expiry for the key", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_redis_remove_key_time_milli_seconds", help: "total time taken to remove keys from redis which are out of window", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_scheduler_cron_entries", help: "Count of resolved periodic-schedule entries from the last refresh, by source, connector, stagger mode, and origin.", unit: "", constLabels: {}, variableLabels: {source,connector_id,stagger_mode,origin}}
Desc{fqName: "tetriz_scheduler_invalid_definitions_total", help: "Schedule definitions dropped because their ID, job type or cron expression is invalid, by source.", unit: "", constLabels: {}, variableLabels: {source}}
Desc{fqName: "tetriz_scheduler_periodic_tasks", help: "Number of distinct periodic tasks produced by the last schedule-source aggregation.", unit: "", constLabels: {}, variableLabels: {}}
Desc{fqName: "tetriz_scheduler_refresh_duration_seconds", help: "Wall-clock duration of one ConfigProvider.GetConfigs aggregation across all schedule sources.", unit: "", constLabels: {}, variableLabels: {}}
