# Every variable tetriz-connectors reads, with its default. The values below
# are placeholders or local-only defaults; never commit a filled-in copy.

# Host ports docker-compose.yml publishes; change them when another stack holds one.
TETRIZ_PG_PORT=55432
TETRIZ_REDIS_PORT=56379
TETRIZ_RUNNER_PORT=9090
# The image docker-compose.yml runs. Unset, compose builds this checkout as
# tetriz-connectors:local; set it to a release image and pass --no-build to pull.
TETRIZ_IMAGE=

# Stores. The defaults match the ports docker-compose.yml publishes.
TETRIZ_POSTGRES_DSN="host=localhost port=55432 user=tetriz password=tetriz-local-only dbname=tetriz sslmode=disable"
TETRIZ_REDIS_ADDR=localhost:56379
# The password of TETRIZ_REDIS_ADDR, when it requires one.
TETRIZ_REDIS_PASSWORD=
# Or a redis:// or rediss:// (TLS) URL with an optional user, password and
# database, such as rediss://user:pass@redis.example:6380/0. When set it
# replaces TETRIZ_REDIS_ADDR and TETRIZ_REDIS_PASSWORD.
TETRIZ_REDIS_URL=
# Prefixes the queue names, the leader lock and every other Redis key the
# runner writes with "<namespace>:", so deployments can share one Redis.
# Letters, digits, '.', '_' and '-'. Empty (default) keeps the unprefixed names.
TETRIZ_NAMESPACE=
TETRIZ_SIMULATOR_DSN="host=localhost port=55432 user=tetriz password=tetriz-local-only dbname=tetriz sslmode=disable"

# Credentials at rest: a base64 32-byte AES-256 key (openssl rand -base64 32).
TETRIZ_CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Set to 1 instead to store credentials unencrypted, for a local run only.
TETRIZ_ALLOW_PLAINTEXT_CREDENTIALS=0

# Where records go: "log" (default), "-" for JSON lines on stdout, "postgres"
# for the connector_records table, or a file path.
TETRIZ_SINK=log
# The database TETRIZ_SINK=postgres writes to. Empty means TETRIZ_POSTGRES_DSN.
TETRIZ_SINK_POSTGRES_DSN=
TETRIZ_BLOB_DIR=blobs
TETRIZ_HTTP_ADDR=:9090
TETRIZ_METRICS_PREFIX=tetriz_
TETRIZ_CONCURRENCY=10
# Tenant kind of every organization scheduled runs see: organization or individual.
TETRIZ_DEFAULT_TENANT_KIND=organization
# Optional file overriding it per organization: one organization id and kind per line.
TETRIZ_TENANT_KINDS_FILE=
# A YAML file that replaces the built-in vendor endpoints and rates (gateway/defaults.yaml).
TETRIZ_GATEWAY_CONFIG=
TETRIZ_ENV=development

# GitHub: a GitHub App (id and PEM private key); without one, GitHub configs use a token.
TETRIZ_GITHUB_APP_ID=
TETRIZ_GITHUB_APP_PRIVATE_KEY=

# OAuth applications for the vendors whose tokens refresh.
TETRIZ_JIRA_OAUTH_CLIENT_ID=
TETRIZ_JIRA_OAUTH_CLIENT_SECRET=
TETRIZ_GITLAB_OAUTH_CLIENT_ID=
TETRIZ_GITLAB_OAUTH_CLIENT_SECRET=
TETRIZ_BITBUCKET_OAUTH_CLIENT_ID=
TETRIZ_BITBUCKET_OAUTH_CLIENT_SECRET=
TETRIZ_LINEAR_OAUTH_CLIENT_ID=
TETRIZ_LINEAR_OAUTH_CLIENT_SECRET=

# Tests: the Postgres database the store tests create their databases in,
# whether a missing one fails the run, and a Redis for the rate-limiter tests.
TETRIZ_TEST_POSTGRES_DSN="host=localhost port=55432 user=tetriz password=tetriz-local-only dbname=postgres sslmode=disable"
TETRIZ_REQUIRE_TEST_DB=0
TETRIZ_TEST_REDIS_ADDR=
